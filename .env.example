# Browser configuration. Hosted builds must use a public wss:// endpoint.
VITE_COLYSEUS_URL=ws://localhost:2567
VITE_SERVICE_VERSION=dev

# Server configuration. These local values contain no secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173
SERVICE_NAME=terra-rossa-server
SERVICE_VERSION=dev
