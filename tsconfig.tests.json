{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "tests/**/*.ts",
    "client/src/config.ts",
    "client/src/vite-env.d.ts",
    "server/config.ts",
    "server/index.ts",
    "server/logger.ts",
    "server/rooms/**/*.ts",
    "vitest.config.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
